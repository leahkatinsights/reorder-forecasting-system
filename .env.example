# Copy to .env and fill in real values. .env is gitignored.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# Shopify location IDs (find in admin → Settings → Locations → click row, ID is in URL)
SHOPIFY_LOCATION_CLINIC=
SHOPIFY_LOCATION_WSA=

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxx

# Square (optional - leave blank to skip Square sales)
# Get token from https://developer.squareup.com/apps (production access token)
# Get location ID via Square admin -> Locations, or via /v2/locations API
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
